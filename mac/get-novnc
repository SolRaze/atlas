#!/bin/sh
# noVNC into mac/web/novnc, served same-origin at /mac/novnc/: the viewer
# reads its canvas, which a cross-origin frame would forbid.
set -e
V=${NOVNC_VERSION:-v1.6.0}
cd "$(dirname "$0")/web"
rm -rf novnc
mkdir novnc
curl -fsSL "https://github.com/novnc/noVNC/archive/refs/tags/$V.tar.gz" | tar -xz --strip-components=1 -C novnc
test -f novnc/vnc.html
echo "noVNC $V in $(pwd)/novnc"
